{
  "name": "cf-senders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Send emails using Cloudflare Workers.",
  "scripts": {
    "cf-typegen": "wrangler types",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && eslint . && dprint check",
    "format": "dprint fmt",
    "test": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && eslint . && dprint check",
    "deploy": "vite build && wrangler deploy",
    "deploy:dry-run": "vite build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@dprint/json": "^0.23.0",
    "@dprint/markdown": "^0.23.2",
    "@dprint/typescript": "^0.96.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "dprint": "^0.56.1",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.1",
    "@lucide/svelte": "^1.38.0"
  }
}
