{
  "lineWidth": 120,
  "typescript": {
    "quoteStyle": "alwaysDouble",
    "semiColons": "always"
  },
  "json": {
    "indentWidth": 2
  },
  "markdown": {},
  "incremental": false,
  "includes": ["**/*.{css,js,json,jsonc,md,mjs,svelte,ts}"],
  "excludes": [
    "**/.svelte-kit/**",
    "**/dist/**",
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "worker-configuration.d.ts"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.2",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:lax-css@0.3.0"
  ]
}
