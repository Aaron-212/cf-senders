{
  "name": "cf-senders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Send emails using Cloudflare Workers.",
  "scripts": {
    "cf-typegen": "wrangler types",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json && oxlint . && oxfmt --check .",
    "format": "oxfmt --write .",
    "test": "wrangler types --check && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json && oxlint . && oxfmt --check . && node --test src/lib/server/cloudflare-access.test.mjs",
    "deploy": "vite build && wrangler deploy",
    "deploy:dry-run": "vite build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "cn": "^0.2.2",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "shadcn-svelte": "^1.6.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.39.0",
    "jose": "^6.2.10"
  }
}
